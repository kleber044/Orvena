  dotClosed: { backgroundColor: "#777E89" },
  statusText: { color: "#747B86", fontSize: 8 },
  closeChatButton: {
    borderRadius: 9,
    borderWidth: 1,
    borderColor: "#513039",
    backgroundColor: "#201418",
    paddingHorizontal: 9,
    paddingVertical: 8,
  },
  closeChatText: { color: "#FF8F98", fontSize: 7, fontWeight: "900" },
  errorBox: {
    borderRadius: 12,
    borderWidth: 1,
    borderColor: "#552C35",
    backgroundColor: "#211217",
    padding: 10,
    marginTop: 10,
  },
  errorText: { color: "#FF8A93", fontSize: 9 },
  messages: { flex: 1 },
  messagesContent: { paddingVertical: 15, gap: 10 },
  infoBubble: {
    alignSelf: "center",
    borderRadius: 999,
    backgroundColor: "#171A20",
