import { Ionicons } from "@expo/vector-icons";
import { useAudioPlayer } from "expo-audio";
import { router, useLocalSearchParams } from "expo-router";
import { useCallback, useEffect, useRef, useState } from "react";
import {
  ActivityIndicator,
  Alert,
  KeyboardAvoidingView,
  Platform,
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  TextInput,
  View,
  useWindowDimensions,
} from "react-native";
import { SafeAreaView } from "react-native-safe-area-context";

import { supabase } from "../../../lib/supabase";

type Chamado = {
  id: string;
  user_id: string;
  assunto: string;
  status: "aberto" | "fechado";
  fechado_por: "usuario" | "admin" | null;
  admin_id: string | null;
  admin_email: string | null;
  admin_nome: string | null;
  assumido_em: string | null;
  criado_em: string;
  atualizado_em: string;
};

type Mensagem = {
  id: string;
  remetente_tipo: "usuario" | "admin" | "sistema";
  remetente_email: string | null;
  mensagem: string;
  criado_em: string;
};

function hora(valor: string) {
  const data = new Date(valor);
  if (Number.isNaN(data.getTime())) return "";

  return data.toLocaleTimeString("pt-BR", {
    hour: "2-digit",
    minute: "2-digit",
  });
}

export default function SuporteChatScreen() {
  const { width } = useWindowDimensions();
  const desktop = width >= 960;
  const params = useLocalSearchParams<{ id: string }>();
  const chamadoId = Array.isArray(params.id) ? params.id[0] : params.id;

  const sendPlayer = useAudioPlayer(
    require("../../../assets/sounds/support-send.wav")
  );
  const receivePlayer = useAudioPlayer(
    require("../../../assets/sounds/support-receive.wav")
  );

  const scrollRef = useRef<ScrollView>(null);
  const adminMessagesCountRef = useRef(0);
  const initialMessagesLoadedRef = useRef(false);

  const [chamado, setChamado] = useState<Chamado | null>(null);
  const [mensagens, setMensagens] = useState<Mensagem[]>([]);
  const [texto, setTexto] = useState("");
  const [carregando, setCarregando] = useState(true);
  const [enviando, setEnviando] = useState(false);
  const [fechando, setFechando] = useState(false);
  const [erro, setErro] = useState("");

  const carregar = useCallback(
    async (mostrarLoading = false) => {
      if (!chamadoId) return;

      try {
        if (mostrarLoading) setCarregando(true);

        const {
          data: { user },
        } = await supabase.auth.getUser();

        if (!user) {
          router.replace("/login" as any);
          return;
        }

        const [chamadoResult, mensagensResult] = await Promise.all([
          supabase
            .from("suporte_chamados")
            .select("*")
            .eq("id", chamadoId)
            .eq("user_id", user.id)
            .maybeSingle(),
          supabase
            .from("suporte_mensagens")
            .select(
              "id, remetente_tipo, remetente_email, mensagem, criado_em"
            )
            .eq("chamado_id", chamadoId)
            .order("criado_em", { ascending: true }),
        ]);

        if (chamadoResult.error || !chamadoResult.data) {
          setErro("Atendimento não encontrado.");
          return;
        }

        if (mensagensResult.error) {
          console.log("Erro mensagens suporte:", mensagensResult.error);
          setErro("Não foi possível carregar as mensagens.");
          return;
        }

        const novasMensagens =
          (mensagensResult.data || []) as Mensagem[];

        const totalAdmin = novasMensagens.filter(
          (item) => item.remetente_tipo === "admin"
        ).length;

        if (
          initialMessagesLoadedRef.current &&
          totalAdmin > adminMessagesCountRef.current
        ) {
          const novasDoAdmin =
            totalAdmin - adminMessagesCountRef.current;

          for (
            let indice = 0;
            indice < novasDoAdmin;
            indice += 1
          ) {
            setTimeout(() => {
              try {
                receivePlayer.seekTo(0);
                receivePlayer.play();
              } catch (error) {
                console.log(
                  "Erro ao tocar som de recebimento:",
                  error
                );
              }
            }, indice * 450);
          }
        }

        adminMessagesCountRef.current = totalAdmin;
        initialMessagesLoadedRef.current = true;

        setChamado(chamadoResult.data as Chamado);
        setMensagens(novasMensagens);
        setErro("");
      } finally {
        setCarregando(false);
      }
    },
    [chamadoId, receivePlayer]
  );

  useEffect(() => {
    void carregar(true);

    const timer = setInterval(() => {
      void carregar(false);
    }, 2500);

    return () => clearInterval(timer);
  }, [carregar]);

  useEffect(() => {
    const timer = setTimeout(() => {
      scrollRef.current?.scrollToEnd({ animated: true });
    }, 100);

    return () => clearTimeout(timer);
  }, [mensagens.length]);

  async function enviar() {
    const mensagem = texto.trim();

    if (!mensagem || !chamadoId || chamado?.status !== "aberto") {
      return;
    }

    try {
      setEnviando(true);

      const {
        data: { user },
      } = await supabase.auth.getUser();

      if (!user) {
        router.replace("/login" as any);
        return;
      }

      const agora = new Date().toISOString();

      const { error } = await supabase.from("suporte_mensagens").insert({
        chamado_id: chamadoId,
        remetente_tipo: "usuario",
        remetente_id: user.id,
        remetente_email: user.email || null,
        mensagem,
        criado_em: agora,
      });

      if (error) {
        console.log("Erro enviar chat:", error);
        setErro("Não foi possível enviar sua mensagem.");
        return;
      }

      await supabase
        .from("suporte_chamados")
        .update({ atualizado_em: agora })
        .eq("id", chamadoId)
        .eq("user_id", user.id)
        .eq("status", "aberto");

      try {
        sendPlayer.seekTo(0);
        sendPlayer.play();
      } catch (error) {
        console.log("Erro ao tocar som de envio:", error);
      }

      setTexto("");
      await carregar(false);
    } finally {
      setEnviando(false);
    }
  }

  function confirmarFechamento() {
    if (chamado?.status !== "aberto") return;

    if (Platform.OS === "web") {
      if (typeof globalThis.confirm === "function" && globalThis.confirm("Encerrar atendimento?\n\nDepois de encerrado, este chat ficará somente para consulta.")) {
        void fecharChat();
      }
      return;
    }

    Alert.alert(
      "Encerrar atendimento?",
      "Depois de encerrado, este chat ficará somente para consulta.",
      [
        { text: "Cancelar", style: "cancel" },
        {
          text: "Encerrar",
          style: "destructive",
          onPress: () => void fecharChat(),
        },
      ]
    );
  }

  async function fecharChat() {
    if (!chamadoId) return;

    try {
      setFechando(true);

      const {
        data: { user },
      } = await supabase.auth.getUser();

      if (!user) return;

      const agora = new Date().toISOString();

      const { error } = await supabase
        .from("suporte_chamados")
        .update({
          status: "fechado",
          fechado_por: "usuario",
          fechado_por_nome: "Usuário",
          fechado_por_email: user.email || null,
          fechado_em: agora,
          atualizado_em: agora,
        })
        .eq("id", chamadoId)
        .eq("user_id", user.id)
        .eq("status", "aberto");

      if (error) {
        setErro("Não foi possível encerrar o atendimento.");
        return;
      }

      await carregar(false);
    } finally {
      setFechando(false);
    }
  }

  if (carregando) {
    return (
      <SafeAreaView style={styles.safeArea}>
        <View style={styles.loading}>
          <ActivityIndicator size="large" color="#7C5CFF" />
        </View>
      </SafeAreaView>
    );
  }

  return (
    <SafeAreaView style={styles.safeArea}>
      <KeyboardAvoidingView
        style={styles.flex}
        behavior={Platform.OS === "ios" ? "padding" : undefined}
      >
        <View style={[styles.page, desktop && styles.pageDesktop]}>
          <View style={styles.header}>
            <Pressable style={styles.backButton} onPress={() => router.back()}>
              <Ionicons name="arrow-back" size={21} color="#FFFFFF" />
            </Pressable>

            <View style={styles.headerMain}>
              <Text style={styles.eyebrow}>SUPORTE ORVENA</Text>
              <Text style={styles.title} numberOfLines={1}>
                {chamado?.assunto || "Atendimento"}
              </Text>

              <View style={styles.statusRow}>
                <View
                  style={[
                    styles.dot,
                    chamado?.status === "aberto"
                      ? styles.dotOpen
                      : styles.dotClosed,
                  ]}
                />

                <Text style={styles.statusText}>
                  {chamado?.status === "aberto"
                    ? chamado.admin_nome
                      ? `Atendido por ${chamado.admin_nome}`
                      : "Aguardando um administrador"
                    : `Atendimento encerrado${
                        chamado?.fechado_por === "admin"
                          ? " pelo suporte"
                          : " por você"
                      }`}
                </Text>
              </View>
            </View>

            {chamado?.status === "aberto" ? (
              <Pressable
                style={styles.closeChatButton}
                onPress={confirmarFechamento}
                disabled={fechando}
              >
                <Ionicons name="close-circle-outline" size={16} color="#FFACB5" /><Text style={styles.closeChatText}>
                  {fechando ? "..." : "ENCERRAR"}
                </Text>
              </Pressable>
            ) : null}
          </View>

          {erro ? (
            <View style={styles.errorBox}>
              <Text style={styles.errorText}>{erro}</Text>
            </View>
          ) : null}

          <View style={styles.conversationHeader}>
            <View style={styles.conversationIcon}><Ionicons name="shield-checkmark-outline" size={19} color="#B9A8FF" /></View>
            <View style={{ flex: 1 }}><Text style={styles.conversationHeading}>Conversa de atendimento</Text><Text style={styles.conversationSubheading}>Suas mensagens ficam registradas neste chamado.</Text></View>
          </View>

          <ScrollView
            ref={scrollRef}
            style={styles.messages}
            contentContainerStyle={styles.messagesContent}
            showsVerticalScrollIndicator={false}
            onContentSizeChange={() =>
              scrollRef.current?.scrollToEnd({ animated: true })
            }
          >
            <View style={styles.infoBubble}>
              <Text style={styles.infoBubbleText}>
                Você está falando com o suporte do Orvena.
              </Text>
            </View>

            {mensagens.map((item) => {
              if (item.remetente_tipo === "sistema") {
                return (
                  <View key={item.id} style={styles.systemMessage}>
                    <View style={styles.systemLine} />
                    <View style={styles.systemPill}>
                      <Text style={styles.systemIcon}>✦</Text>
                      <Text style={styles.systemText}>{item.mensagem}</Text>
                    </View>
                    <View style={styles.systemLine} />
                  </View>
                );
              }

              const usuario = item.remetente_tipo === "usuario";

              return (
                <View
                  key={item.id}
                  style={[
                    styles.messageRow,
                    usuario
                      ? styles.messageRowUser
                      : styles.messageRowAdmin,
                  ]}
                >
                  {!usuario ? (
                    <View style={styles.adminAvatar}>
                      <Ionicons name="headset-outline" size={19} color="#FFFFFF" />
                    </View>
                  ) : null}

                  <View
                    style={[
                      styles.messageBubble,
                      usuario
                        ? styles.messageBubbleUser
                        : styles.messageBubbleAdmin,
                    ]}
                  >
                    {!usuario ? (
                      <Text style={styles.senderName}>
                        {chamado?.admin_nome || "Suporte Orvena"}
                      </Text>
                    ) : null}

                    <Text
                      style={[
                        styles.messageText,
                        usuario && styles.messageTextUser,
                      ]}
                    >
                      {item.mensagem}
                    </Text>

                    <Text
                      style={[
                        styles.messageTime,
                        usuario && styles.messageTimeUser,
                      ]}
                    >
                      {hora(item.criado_em)}
                    </Text>
                  </View>
                </View>
              );
            })}

            {chamado?.status === "fechado" ? (
              <View style={styles.closedCard}>
                <Text style={styles.closedTitle}>Atendimento encerrado</Text>
                <Text style={styles.closedText}>
                  Este chat está fechado e não aceita novas mensagens.
                </Text>
              </View>
            ) : null}
          </ScrollView>

          {chamado?.status === "aberto" ? (
            <View style={styles.composer}>
              <TextInput
                value={texto}
                onChangeText={setTexto}
                placeholder="Digite sua mensagem..."
                placeholderTextColor="#59606B"
                style={styles.composerInput}
                multiline
                maxLength={2500}
                returnKeyType="send"
                submitBehavior="submit"
                onSubmitEditing={() => {
                  if (
                    texto.trim() &&
                    !enviando
                  ) {
                    void enviar();
                  }
                }}
              />

              <Pressable
                style={[
                  styles.sendButton,
                  (!texto.trim() || enviando) && styles.sendButtonDisabled,
                ]}
                onPress={enviar}
                disabled={!texto.trim() || enviando}
              >
                {enviando ? (
                  <ActivityIndicator size="small" color="#FFFFFF" />
                ) : (
                  <Ionicons name="send" size={21} color="#FFFFFF" />
                )}
              </Pressable>
            </View>
          ) : (
            <Pressable
              style={styles.backSupportButton}
              onPress={() => router.replace("/suporte" as any)}
            >
              <Text style={styles.backSupportText}>
                VOLTAR PARA CENTRAL DE SUPORTE
              </Text>
            </Pressable>
          )}
        </View>
      </KeyboardAvoidingView>
    </SafeAreaView>
  );
}

const styles = StyleSheet.create({
  safeArea: { flex: 1, backgroundColor: "#09090F" },
  flex: { flex: 1 },
  loading: { flex: 1, alignItems: "center", justifyContent: "center" },
  page: { flex: 1, width: "100%", maxWidth: 920, alignSelf: "center", paddingHorizontal: 12, paddingTop: 12, paddingBottom: 10 },
  pageDesktop: { maxWidth: 1160, paddingHorizontal: 30, paddingTop: 25, paddingBottom: 20 },
  header: { flexDirection: "row", alignItems: "center", gap: 13, paddingBottom: 19, borderBottomWidth: 1, borderBottomColor: "#322D3E" },
  backButton: { width: 46, height: 46, borderRadius: 14, borderWidth: 1, borderColor: "#3D354C", backgroundColor: "#1B1723", alignItems: "center", justifyContent: "center" },
  backText: { color: "#FFFFFF", fontSize: 22, fontWeight: "800" },
  headerMain: { flex: 1, minWidth: 0 },
  eyebrow: { color: "#B7A5FF", fontSize: 10, fontWeight: "800", letterSpacing: 1.2 },
  title: { color: "#FFFFFF", fontSize: 20, fontWeight: "800", marginTop: 4 },
  statusRow: { flexDirection: "row", alignItems: "center", gap: 7, marginTop: 7 },
  dot: { width: 8, height: 8, borderRadius: 4 },
  dotOpen: { backgroundColor: "#55DCA0" },
  dotClosed: { backgroundColor: "#9994A5" },
  statusText: { color: "#B4ACBE", fontSize: 11, flexShrink: 1 },
  closeChatButton: { borderRadius: 12, borderWidth: 1, borderColor: "#69404E", backgroundColor: "#2D1922", paddingHorizontal: 11, paddingVertical: 11, flexDirection: "row", alignItems: "center", gap: 6 },
  closeChatText: { color: "#FFACB5", fontSize: 11, fontWeight: "800" },
  errorBox: { borderRadius: 12, borderWidth: 1, borderColor: "#664050", backgroundColor: "#2B1822", padding: 14, marginTop: 12 },
  errorText: { color: "#FFACB5", fontSize: 12, lineHeight: 19 },
  conversationHeader: { flexDirection: "row", alignItems: "center", gap: 11, paddingHorizontal: 14, paddingVertical: 14, backgroundColor: "#17131F", borderWidth: 1, borderColor: "#352D43", borderTopLeftRadius: 17, borderTopRightRadius: 17, marginTop: 15 },
  conversationIcon: { width: 39, height: 39, borderRadius: 12, backgroundColor: "#302441", justifyContent: "center", alignItems: "center" },
  conversationHeading: { color: "#FFFFFF", fontSize: 13, fontWeight: "800" },
  conversationSubheading: { color: "#9D95AB", fontSize: 11, marginTop: 4 },
  messages: { flex: 1, backgroundColor: "#0F0E15", borderWidth: 1, borderTopWidth: 0, borderColor: "#352D43", borderBottomLeftRadius: 17, borderBottomRightRadius: 17 },
  messagesContent: { paddingHorizontal: 15, paddingVertical: 23, gap: 17, flexGrow: 1 },
  infoBubble: { alignSelf: "center", borderRadius: 999, borderWidth: 1, borderColor: "#393044", backgroundColor: "#201A28", paddingHorizontal: 14, paddingVertical: 9, marginBottom: 10 },
  infoBubbleText: { color: "#B8AEC6", fontSize: 11, textAlign: "center" },
  systemMessage: { flexDirection: "row", alignItems: "center", gap: 8, marginVertical: 5 },
  systemLine: { flex: 1, height: 1, backgroundColor: "#35303F" },
  systemPill: { flexDirection: "row", alignItems: "center", gap: 7, borderRadius: 15, borderWidth: 1, borderColor: "#514269", backgroundColor: "#211A2D", paddingHorizontal: 11, paddingVertical: 9, maxWidth: "85%" },
  systemIcon: { color: "#B7A5FF", fontSize: 12 },
  systemText: { color: "#C2B8D0", fontSize: 11, fontWeight: "600", flexShrink: 1 },
  messageRow: { flexDirection: "row", alignItems: "flex-end", gap: 10 },
  messageRowUser: { justifyContent: "flex-end" },
  messageRowAdmin: { justifyContent: "flex-start" },
  adminAvatar: { width: 36, height: 36, borderRadius: 12, backgroundColor: "#5540A6", alignItems: "center", justifyContent: "center" },
  adminAvatarText: { color: "#FFFFFF", fontSize: 13, fontWeight: "800" },
  messageBubble: { maxWidth: "78%", borderRadius: 18, paddingHorizontal: 16, paddingVertical: 13 },
  messageBubbleUser: { backgroundColor: "#694DEA", borderBottomRightRadius: 5 },
  messageBubbleAdmin: { backgroundColor: "#211E2B", borderWidth: 1, borderColor: "#3C354B", borderBottomLeftRadius: 5 },
  senderName: { color: "#BEAEFF", fontSize: 11, fontWeight: "800", marginBottom: 7 },
  messageText: { color: "#F4F1F8", fontSize: 14, lineHeight: 22 },
  messageTextUser: { color: "#FFFFFF" },
  messageTime: { color: "#ADA5BA", fontSize: 10, textAlign: "right", marginTop: 8 },
  messageTimeUser: { color: "#E5DFFF" },
  closedCard: { alignSelf: "center", width: "90%", maxWidth: 470, borderRadius: 16, borderWidth: 1, borderColor: "#53485D", backgroundColor: "#211E27", padding: 18, marginTop: 18 },
  closedTitle: { color: "#FFFFFF", fontSize: 14, fontWeight: "800", textAlign: "center" },
  closedText: { color: "#AAA1B4", fontSize: 12, lineHeight: 19, textAlign: "center", marginTop: 7 },
  composer: { flexDirection: "row", alignItems: "flex-end", gap: 11, borderTopWidth: 1, borderTopColor: "#332C40", paddingTop: 15, paddingBottom: 5 },
  composerInput: { flex: 1, minHeight: 54, maxHeight: 145, borderRadius: 16, borderWidth: 1, borderColor: "#433A50", backgroundColor: "#18151F", color: "#FFFFFF", fontSize: 14, lineHeight: 21, paddingHorizontal: 16, paddingTop: 14, paddingBottom: 14 },
  sendButton: { width: 54, height: 54, borderRadius: 16, backgroundColor: "#7C5CFF", alignItems: "center", justifyContent: "center" },
  sendButtonDisabled: { opacity: 0.35 },
  sendButtonText: { color: "#FFFFFF", fontSize: 20, fontWeight: "800" },
  backSupportButton: { minHeight: 52, borderRadius: 14, backgroundColor: "#262035", alignItems: "center", justifyContent: "center", marginTop: 12 },
  backSupportText: { color: "#C4B5FF", fontSize: 12, fontWeight: "800" },
});
