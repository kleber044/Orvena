    marginBottom: 14,
  },
  errorText: { color: "#FF8A93", fontSize: 10 },
  card: {
    borderRadius: 20,
    borderWidth: 1,
    borderColor: "#2B3039",
    backgroundColor: "#12151B",
    padding: 17,
  },
  agentRow: {
    flexDirection: "row",
    alignItems: "center",
    gap: 12,
  },
  agentAvatar: {
    width: 48,
    height: 48,
    borderRadius: 15,
    backgroundColor: "#211B38",
    alignItems: "center",
    justifyContent: "center",
  },
  agentEmoji: { fontSize: 23 },
  agentMain: { flex: 1 },
  agentTitle: { color: "#FFFFFF", fontSize: 12, fontWeight: "900" },
  agentSubtitle: {
    color: "#747B86",
    fontSize: 9,
    lineHeight: 14,
    marginTop: 4,
  },
  divider: {
    height: 1,
    backgroundColor: "#252A32",
    marginVertical: 16,
  },
  label: {
    color: "#858C97",
