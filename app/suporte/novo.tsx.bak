    textAlign: "right",
    marginBottom: 14,
  },
  sendButton: {
    minHeight: 51,
    borderRadius: 14,
    backgroundColor: "#7C5CFF",
    alignItems: "center",
    justifyContent: "center",
  },
  sendButtonDisabled: { opacity: 0.35 },
  sendButtonText: {
    color: "#FFFFFF",
    fontSize: 9,
    fontWeight: "900",
    letterSpacing: 0.5,
  },
  notice: {
    borderRadius: 16,
