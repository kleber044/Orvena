    borderColor: "#292E37",
    backgroundColor: "#111319",
    padding: 14,
    marginTop: 12,
  },
  noticeTitle: { color: "#D9DCE1", fontSize: 10, fontWeight: "900" },
  noticeText: {
    color: "#747B86",
