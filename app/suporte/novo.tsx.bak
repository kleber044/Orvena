    marginBottom: 7,
  },
  input: {
    minHeight: 50,
    borderRadius: 14,
    borderWidth: 1,
    borderColor: "#292E37",
    backgroundColor: "#0E1116",
    paddingHorizontal: 13,
    color: "#FFFFFF",
