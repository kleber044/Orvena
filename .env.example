# Chave publishable (anon) do Supabase. Nunca coloque a service role neste app.
EXPO_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua_chave_publishable

# Chave pública do Mercado Pago. O valor do plano é definido nas Edge Functions.
EXPO_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST-sua_chave_publica

# Opcional. Só busca o texto da manutenção depois que o Supabase confirma que ela está ativa.
EXPO_PUBLIC_ADMIN_API_URL=https://admin.seudominio.com
